{
  "name": "wayfinder-backend",
  "version": "1.0.0",
  "description": "Wayfinder / S-CADE backend \u2014 Express + TypeScript + MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npx ts-node tests/scade.test.ts && npx ts-node tests/overpassService.test.ts && npx ts-node tests/geoapifyService.test.ts && npx ts-node tests/discoveryIntegration.test.ts && npx ts-node tests/favoritesEnrichment.test.ts && npx ts-node tests/validation.test.ts && npx ts-node tests/seed.test.ts",
    "test:scade": "npx ts-node tests/scade.test.ts",
    "test:geoapify": "npx ts-node tests/geoapifyService.test.ts",
    "test:overpass": "npx ts-node tests/overpassService.test.ts",
    "test:validation": "npx ts-node tests/validation.test.ts",
    "seed": "ts-node src/seed/seed.ts",
    "test:seed": "npx ts-node tests/seed.test.ts",
    "test:discovery": "npx ts-node tests/discoveryIntegration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
