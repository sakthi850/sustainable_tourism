# Copy to .env and replace placeholders locally. Never commit or distribute .env.
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/wayfinder?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-secret>
OVERPASS_API_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
# Optional legacy provider key; OpenStreetMap discovery does not require it.
GEOAPIFY_API_KEY=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Weather uses Open-Meteo and does not require an API key.
